# Application
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Supabase (server-side service role must never be exposed to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=promise-evidence

# PayPal — use Sandbox values for local development and hackathon demo
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI provider (choose one and keep its key server-side)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Security / operations
SESSION_SECRET=
EVIDENCE_MAX_UPLOAD_BYTES=10485760
ALLOWED_EVIDENCE_HOSTS=
SENTRY_DSN=
