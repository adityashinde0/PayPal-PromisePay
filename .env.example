# Application
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Relational Database (PostgreSQL / Supabase / SQLite)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promisepay
# Fallback local dev: sqlite+aiosqlite:///promisepay.db

# Distributed Cache & Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Supabase (server-side service role must never be exposed to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=promise-evidence

# PayPal — use Sandbox values for local development and hackathon demo
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI provider (Google Gemini)
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Security / operations
SESSION_SECRET=
EVIDENCE_MAX_UPLOAD_BYTES=10485760
ALLOWED_EVIDENCE_HOSTS=github.com,gitlab.com
SENTRY_DSN=

# Hackathon Sponsor Integrations (Optional)
ZAPIER_WEBHOOK_URL=
KERNEL_API_KEY=
CHANNEL3_API_KEY=
ELASTIC_URL=
ELASTIC_API_KEY=
